<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BatteryIntelligence.Notifications</RootNamespace>
  </PropertyGroup>

  <!--
    Plain net10.0, not net10.0-windows: the alert engine and the monitoring
    orchestrator are pure logic over Core interfaces. The one Windows API
    (AppNotificationManager) lives in WindowsToastPresenter in the App project,
    behind the INotificationPresenter seam declared in Core — so the whole alert
    engine is unit-testable and Notifications stays an infrastructure sibling
    (docs/architecture.md section 3), like Analytics.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BatteryIntelligence.Core\BatteryIntelligence.Core.csproj" />
  </ItemGroup>

</Project>
