<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BatteryIntelligence.App.Controls.MetricStat"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- The repeated label / value / (unit) / (badge) / (caption) tile in hero split cards. -->
    <StackPanel Spacing="3" MinWidth="120">
        <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="{x:Bind Label, Mode=OneWay}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock
                x:Name="ValueText"
                Style="{StaticResource SecondaryMetricTextStyle}"
                Text="{x:Bind Value, Mode=OneWay}" />
            <TextBlock
                x:Name="UnitText"
                Style="{StaticResource MetricUnitTextStyle}"
                Text="{x:Bind Unit, Mode=OneWay}" />
        </StackPanel>
        <Border
            x:Name="BadgeBorder"
            Style="{StaticResource GradeBadgeBorderStyle}"
            HorizontalAlignment="Left"
            Visibility="Collapsed">
            <TextBlock Style="{StaticResource GradeBadgeTextStyle}" Text="{x:Bind BadgeText, Mode=OneWay}" />
        </Border>
        <TextBlock
            x:Name="CaptionText"
            Style="{StaticResource MetricLabelTextStyle}"
            Visibility="Collapsed"
            Text="{x:Bind Caption, Mode=OneWay}"
            TextWrapping="Wrap" />
    </StackPanel>

</UserControl>
