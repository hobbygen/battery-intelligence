<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BatteryIntelligence.App.Controls.EmptyStateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Specification section 43: never show a blank card, and always explain why
        there is nothing to show. The Description property is required rather than
        optional for exactly that reason. Rendered as the design's centred card.
    -->
    <Border Style="{StaticResource CardBorderStyle}" Padding="26,44,26,44">
        <StackPanel
            MaxWidth="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">

            <FontIcon
                FontSize="40"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource AppText3Brush}"
                Glyph="{x:Bind Glyph, Mode=OneWay}" />

            <TextBlock
                x:Name="DashText"
                HorizontalAlignment="Center"
                FontSize="40"
                FontWeight="SemiBold"
                Foreground="{ThemeResource AppText3Brush}"
                Visibility="Collapsed"
                Text="&#x2014;" />

            <TextBlock
                HorizontalAlignment="Center"
                HorizontalTextAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                FontSize="18"
                Text="{x:Bind Title, Mode=OneWay}"
                TextWrapping="Wrap" />

            <TextBlock
                HorizontalAlignment="Center"
                HorizontalTextAlignment="Center"
                Foreground="{ThemeResource AppText2Brush}"
                Style="{StaticResource BodyTextBlockStyle}"
                FontSize="13.5"
                Text="{x:Bind Description, Mode=OneWay}"
                TextWrapping="Wrap" />

            <Button
                x:Name="ActionBtn"
                HorizontalAlignment="Center"
                Margin="0,4,0,0"
                Visibility="Collapsed"
                Content="{x:Bind ActionText, Mode=OneWay}"
                Click="OnActionClick" />

        </StackPanel>
    </Border>

</UserControl>
