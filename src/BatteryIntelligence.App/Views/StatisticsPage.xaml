<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BatteryIntelligence.App.Views.StatisticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BatteryIntelligence.App.Controls"
    xmlns:vm="using:BatteryIntelligence.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="StatTileTemplate" x:DataType="vm:StatTile">
            <Grid Padding="4,12" ColumnSpacing="14" BorderBrush="{ThemeResource AppLine2Brush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="{x:Bind Label}" />
                    <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="{x:Bind Sub}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SecondaryMetricTextStyle}" FontSize="18" Text="{x:Bind Value}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="{StaticResource PageContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Statistics" />
                <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Margin="16,4,0,0"
                VerticalAlignment="Top"
                AutomationProperties.Name="Recompute statistics now"
                Command="{x:Bind ViewModel.RefreshCommand}"
                Content="Refresh" />
        </Grid>

        <controls:EmptyStateView
            Grid.Row="1"
            VerticalAlignment="Top"
            Glyph="&#xE9D9;"
            Title="Computing…"
            Description="Aggregating your session history."
            Visibility="{x:Bind ViewModel.ShowLoading, Mode=OneWay}" />

        <controls:EmptyStateView
            Grid.Row="1"
            VerticalAlignment="Top"
            Glyph="&#xE9D9;"
            Title="No sessions in this period"
            Description="There are no charge or discharge sessions in the selected window yet. Statistics fill in as the app records more of your usage."
            Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}" />

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Auto"
            Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}">
            <StackPanel MaxWidth="1000" HorizontalAlignment="Left" Spacing="20">

                <controls:Segmented
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Time window"
                    ItemsSource="{x:Bind ViewModel.WindowOptions}"
                    SelectedIndex="{x:Bind ViewModel.SelectedWindowIndex, Mode=TwoWay}" />

                <!-- Summary tiles -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <controls:CardHeader Glyph="&#xE9D9;" Text="SUMMARY" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Tiles, Mode=OneWay}" ItemTemplate="{StaticResource StatTileTemplate}" />
                    </StackPanel>
                </Border>

                <!-- Charge vs discharge -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <controls:CardHeader Glyph="&#xE945;" Text="TIME ON BATTERY VS CHARGING" />
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="{x:Bind ViewModel.DischargeBarLabel, Mode=OneWay}" />
                            <ProgressBar Minimum="0" Maximum="100" Height="10" Value="{x:Bind ViewModel.DischargeBarPercent, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="{x:Bind ViewModel.ChargeBarLabel, Mode=OneWay}" />
                            <ProgressBar Minimum="0" Maximum="100" Height="10" Foreground="{ThemeResource AppOkBrush}" Value="{x:Bind ViewModel.ChargeBarPercent, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Screen on -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <controls:CardHeader Glyph="&#xE7B5;" Text="SCREEN-ON SHARE" />
                        <ProgressBar Minimum="0" Maximum="100" Height="10" Value="{x:Bind ViewModel.ScreenOnPercent, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource MetricLabelTextStyle}" TextWrapping="Wrap" Text="{x:Bind ViewModel.ScreenOnLabel, Mode=OneWay}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>

</Page>
