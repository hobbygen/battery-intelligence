<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BatteryIntelligence.App.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BatteryIntelligence.App.Controls"
    xmlns:vm="using:BatteryIntelligence.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto">
        <StackPanel Margin="{StaticResource PageContentMargin}" MaxWidth="1200" HorizontalAlignment="Left" Spacing="20">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Diagnostics" />
                    <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="What this machine exposes, and where each figure in the app comes from." />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Margin="16,4,0,0"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="Copy diagnostics to the clipboard"
                    Command="{x:Bind ViewModel.CopyDiagnosticsCommand}"
                    Content="Copy report" />
            </Grid>

            <Border Style="{StaticResource CardBorderStyle}" Padding="18,16">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" VerticalAlignment="Top" FontSize="20" Foreground="{ThemeResource AppOkBrush}" Glyph="&#xE73E;" />
                    <TextBlock
                        Grid.Column="1"
                        Foreground="{ThemeResource AppText2Brush}"
                        TextWrapping="Wrap"
                        Text="{x:Bind ViewModel.SummaryLine, Mode=OneWay}" />
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Sections, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="20" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DiagnosticSection">
                        <StackPanel Spacing="10">
                            <controls:CardHeader Glyph="&#xE9D2;" Text="{x:Bind Title}" />
                            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                                <ItemsControl ItemsSource="{x:Bind Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DiagnosticEntry">
                                            <Grid Padding="16,11" ColumnSpacing="14" BorderBrush="{ThemeResource AppLine2Brush}" BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="0.34*" />
                                                    <ColumnDefinition Width="0.24*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    Foreground="{ThemeResource AppTextBrush}"
                                                    Text="{x:Bind Feature}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontWeight="SemiBold"
                                                    IsTextSelectionEnabled="True"
                                                    Text="{x:Bind Status}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Foreground="{ThemeResource AppText3Brush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind Source}"
                                                    TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Recent activity (log viewer) -->
            <StackPanel Spacing="10">
                <controls:CardHeader Glyph="&#xE9F9;" Text="RECENT ACTIVITY" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:Segmented
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Log level filter"
                                ItemsSource="{x:Bind ViewModel.LogLevelOptions}"
                                SelectedIndex="{x:Bind ViewModel.SelectedLogLevelIndex, Mode=TwoWay}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button
                                    AutomationProperties.Name="Refresh log"
                                    Command="{x:Bind ViewModel.RefreshLogsCommand}"
                                    Content="Refresh" />
                                <Button
                                    AutomationProperties.Name="Open log folder"
                                    Command="{x:Bind ViewModel.OpenLogFolderCommand}"
                                    Content="Open folder" />
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Foreground="{ThemeResource AppText3Brush}"
                            Style="{StaticResource MetricLabelTextStyle}"
                            Text="No log entries at this level."
                            Visibility="{x:Bind ViewModel.NoLogRows, Mode=OneWay}" />

                        <ScrollViewer
                            MaxHeight="380"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="{x:Bind ViewModel.HasLogRows, Mode=OneWay}">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.LogRows, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LogRow">
                                        <Grid Padding="0,3" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                FontFamily="Consolas"
                                                FontSize="12"
                                                Foreground="{ThemeResource AppText3Brush}"
                                                Text="{x:Bind Time}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Width="64"
                                                FontFamily="Consolas"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource AppText2Brush}"
                                                Text="{x:Bind Level}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                FontFamily="Consolas"
                                                FontSize="12"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind Text}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock
                            Foreground="{ThemeResource AppText3Brush}"
                            Style="{StaticResource MetricLabelTextStyle}"
                            Text="{x:Bind ViewModel.LogDirectoryLine, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</Page>
