<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BatteryIntelligence.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:BatteryIntelligence.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto">
        <StackPanel Margin="{StaticResource PageContentMargin}" MaxWidth="820" HorizontalAlignment="Left" Spacing="24">

            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="About" />
                <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="Battery Intelligence for Windows" />
            </StackPanel>

            <Border Style="{StaticResource CardBorderStyle}" Padding="26">
                <Grid ColumnSpacing="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Width="60" Height="60"
                        CornerRadius="12"
                        Background="{ThemeResource AppAccentSoftBrush}">
                        <FontIcon FontSize="30" Foreground="{ThemeResource AppAccentBrush}" Glyph="&#xE945;" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Style="{StaticResource SecondaryMetricTextStyle}" Text="Battery Intelligence" />
                        <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="{x:Bind ViewModel.VersionLine}" />
                        <TextBlock
                            Margin="0,10,0,0"
                            Foreground="{ThemeResource AppText2Brush}"
                            TextWrapping="Wrap"
                            Text="Everything you need to understand your laptop battery, power consumption and battery health in one place. Readings stay on your device; there is no account and no cloud." />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource CardKickerTextStyle}" Text="SYSTEM" />
                <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.SystemRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AboutRow">
                                <Grid Padding="16,11" ColumnSpacing="14" BorderBrush="{ThemeResource AppLine2Brush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Foreground="{ThemeResource AppText2Brush}" Text="{x:Bind Label}" />
                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" IsTextSelectionEnabled="True" Text="{x:Bind Value}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource CardKickerTextStyle}" Text="ESTIMATION METHODOLOGY" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SecondaryMetricTextStyle}" FontSize="16" Text="Per-application battery impact — AppEnergyV1" />
                        <TextBlock
                            Foreground="{ThemeResource AppText2Brush}"
                            TextWrapping="Wrap"
                            Text="Windows exposes measured per-process energy only through the Energy Estimation Engine's SRUM database, which requires administrator rights. Battery Intelligence never requires elevation, so per-application figures are produced by a documented, versioned model — always labelled Estimated." />

                        <TextBlock FontWeight="SemiBold" Text="How the estimate is built" />
                        <TextBlock Foreground="{ThemeResource AppText2Brush}" TextWrapping="Wrap"
                            Text="1. System budget — over each interval, the only ground truth is the measured battery draw: E_total = |battery power| × time. On AC there is no draw to divide, so absolute figures are reported as unavailable and applications are only ranked." />
                        <TextBlock Foreground="{ThemeResource AppText2Brush}" TextWrapping="Wrap"
                            Text="2. Non-attributable baseline — the display backlight, Wi-Fi and Bluetooth radios and chipset idle belong to no application. That baseline is separated first, learned from this device's own screen-on and screen-off idle draw, and shown as its own slice." />
                        <TextBlock Foreground="{ThemeResource AppText2Brush}" TextWrapping="Wrap"
                            Text="3. Weighted attribution — the remaining budget is divided among applications by an activity weight (CPU share, plus a small bonus for the foreground app). GPU and disk I/O terms exist in the model but are not observable without elevation on this build, so they contribute nothing here." />

                        <TextBlock FontWeight="SemiBold" Text="What this does and does not claim" />
                        <TextBlock Foreground="{ThemeResource AppText2Brush}" TextWrapping="Wrap"
                            Text="It ranks applications by likely battery impact and apportions a measured total among them. It does not measure any single application's consumption — two applications with identical CPU time can differ substantially in real energy use, and none of the deciding factors (instruction mix, wake frequency, GPU work) is fully observable here. Shares always sum to 100% of the attributable budget, with the baseline shown separately so nothing is double-counted." />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource CardKickerTextStyle}" Text="PRIVACY" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" VerticalAlignment="Top" FontSize="20" Foreground="{ThemeResource AppOkBrush}" Glyph="&#xE72E;" />
                        <TextBlock
                            Grid.Column="1"
                            Foreground="{ThemeResource AppText2Brush}"
                            TextWrapping="Wrap"
                            Text="No account required, no cloud synchronisation, no telemetry. All readings live in a single local SQLite database you can export or delete at any time from Settings." />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource CardKickerTextStyle}" Text="ACKNOWLEDGEMENTS" />
                <TextBlock
                    Foreground="{ThemeResource AppText2Brush}"
                    TextWrapping="Wrap"
                    Text="Built with the Windows App SDK and WinUI 3. Charts render on SkiaSharp via LiveChartsCore. Battery capability detection uses the Windows power-management and ACPI interfaces only — no kernel driver is installed." />
            </StackPanel>

            <TextBlock
                Foreground="{ThemeResource AppText3Brush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Battery Intelligence is an independent utility and is not affiliated with Microsoft or any hardware manufacturer." />

        </StackPanel>
    </ScrollViewer>

</Page>
