<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BatteryIntelligence.App.Views.TemperaturePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BatteryIntelligence.App.Controls"
    xmlns:vm="using:BatteryIntelligence.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="BandRowTemplate" x:DataType="vm:TemperatureBandRow">
            <StackPanel Spacing="5" Margin="0,0,0,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="13" Text="{x:Bind Label}" />
                    <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold" Text="{x:Bind DurationText}" />
                </Grid>
                <ProgressBar
                    Minimum="0"
                    Maximum="100"
                    Height="7"
                    Foreground="{x:Bind Fill}"
                    Value="{x:Bind Percent}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ThresholdEventTemplate" x:DataType="vm:ThresholdEventRow">
            <Grid Padding="8,11" ColumnSpacing="12" BorderBrush="{ThemeResource AppLine2Brush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" VerticalAlignment="Top" FontSize="17" Foreground="{ThemeResource AppWarnBrush}" Glyph="&#xE7BA;" />
                <StackPanel Grid.Column="1">
                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Text="{x:Bind Peak}" />
                    <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="{x:Bind Detail}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="2" VerticalAlignment="Top" Style="{StaticResource MetricLabelTextStyle}" Text="{x:Bind When}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="{StaticResource PageContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Temperature" />
                <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Margin="16,4,0,0"
                VerticalAlignment="Top"
                AutomationProperties.Name="Re-check the temperature sensor"
                Command="{x:Bind ViewModel.RefreshCommand}"
                Content="Re-check" />
        </Grid>

        <!-- Unavailable — the reference-machine outcome. -->
        <controls:EmptyStateView
            Grid.Row="1"
            VerticalAlignment="Top"
            Glyph="&#xE9CA;"
            ShowValueDash="True"
            Title="Sensor unavailable"
            Description="This laptop does not expose battery temperature through the Windows or ACPI interfaces Battery Intelligence can read. Nothing is wrong with the battery — the reading simply is not published by the hardware, so no history can be collected. Battery Intelligence does not substitute CPU temperature, which would not reflect battery conditions. Temperature alerts are disabled while the sensor is unavailable."
            Visibility="{x:Bind ViewModel.SensorUnavailable, Mode=OneWay}" />

        <controls:EmptyStateView
            Grid.Row="1"
            VerticalAlignment="Top"
            Glyph="&#xE9CA;"
            Title="Waiting for the first reading"
            Description="A battery temperature sensor was detected. The first reading will appear within a few seconds."
            Visibility="{x:Bind ViewModel.ShowLoading, Mode=OneWay}" />

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Auto"
            Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}">
            <StackPanel MaxWidth="1000" HorizontalAlignment="Left" Spacing="20">

                <!-- Hero -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="24,22">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:CardHeader Grid.Column="0" Glyph="&#xE9CA;" Text="BATTERY TEMPERATURE" />
                            <controls:Segmented
                                Grid.Column="1"
                                ItemsSource="{x:Bind ViewModel.WindowOptions}"
                                SelectedIndex="{x:Bind ViewModel.SelectedWindowIndex, Mode=TwoWay}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
                            <TextBlock Style="{StaticResource HeroMetricTextStyle}" Text="{x:Bind ViewModel.CurrentText, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource MetricUnitTextStyle}" Text="°C" />
                            <Border
                                Style="{StaticResource StatusChipBorderStyle}"
                                Background="{ThemeResource AppOkSoftBrush}"
                                Visibility="{x:Bind ViewModel.IsNormal, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon FontSize="13" Foreground="{ThemeResource AppOkBrush}" Glyph="{x:Bind ViewModel.StatusGlyph, Mode=OneWay}" />
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppOkBrush}" Text="{x:Bind ViewModel.StatusLabel, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border
                                Style="{StaticResource StatusChipBorderStyle}"
                                Background="{ThemeResource AppWarnSoftBrush}"
                                Visibility="{x:Bind ViewModel.IsWarning, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon FontSize="13" Foreground="{ThemeResource AppWarnBrush}" Glyph="{x:Bind ViewModel.StatusGlyph, Mode=OneWay}" />
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppWarnBrush}" Text="{x:Bind ViewModel.StatusLabel, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border
                                Style="{StaticResource StatusChipBorderStyle}"
                                Background="{ThemeResource AppCritSoftBrush}"
                                Visibility="{x:Bind ViewModel.IsCritical, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon FontSize="13" Foreground="{ThemeResource AppCritBrush}" Glyph="{x:Bind ViewModel.StatusGlyph, Mode=OneWay}" />
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppCritBrush}" Text="{x:Bind ViewModel.StatusLabel, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="26">
                            <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="{x:Bind ViewModel.MinText, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="{x:Bind ViewModel.AvgText, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="{x:Bind ViewModel.MaxText, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Trend -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="14">
                        <controls:CardHeader Glyph="&#xE9D2;" Text="TEMPERATURE OVER TIME" />
                        <controls:PowerChart
                            LineAccent="magenta"
                            Series="{x:Bind ViewModel.Series, Mode=OneWay}"
                            ThresholdValue="{x:Bind ViewModel.WarnThreshold, Mode=OneWay}"
                            ThresholdLabel="{x:Bind ViewModel.ThresholdLabel, Mode=OneWay}"
                            RangeStartUtc="{x:Bind ViewModel.SeriesFromUtc, Mode=OneWay}"
                            RangeEndUtc="{x:Bind ViewModel.SeriesToUtc, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- Band breakdown -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="14">
                        <controls:CardHeader Glyph="&#xE9D9;" Text="TIME IN EACH BAND" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.BandRows, Mode=OneWay}" ItemTemplate="{StaticResource BandRowTemplate}" />
                        <TextBlock
                            Style="{StaticResource MetricLabelTextStyle}"
                            TextWrapping="Wrap"
                            Text="Sustained time above 45 °C is the single largest contributor to capacity loss. Boundaries are fixed at 30 / 40 / 45 °C, independent of the alert threshold." />
                    </StackPanel>
                </Border>

                <!-- Threshold events -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <controls:CardHeader Glyph="&#xE7BA;" Text="THRESHOLD EVENTS" />
                        <TextBlock
                            Visibility="{x:Bind ViewModel.NoThresholdEvents, Mode=OneWay}"
                            Foreground="{ThemeResource AppText2Brush}"
                            TextWrapping="Wrap"
                            Text="No threshold events. An event is recorded only when the reading stays above the warning threshold for more than 60 seconds, so brief spikes do not flood the log." />
                        <ItemsControl
                            Visibility="{x:Bind ViewModel.HasThresholdEvents, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.ThresholdEvents, Mode=OneWay}"
                            ItemTemplate="{StaticResource ThresholdEventTemplate}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>

</Page>
