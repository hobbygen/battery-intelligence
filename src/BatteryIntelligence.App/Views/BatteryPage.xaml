<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BatteryIntelligence.App.Views.BatteryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BatteryIntelligence.App.Controls"
    xmlns:vm="using:BatteryIntelligence.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="HealthFactorTemplate" x:DataType="vm:HealthFactorRow">
            <Grid Padding="2,8" ColumnSpacing="12" BorderBrush="{ThemeResource AppLine2Brush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="{x:Bind Label}" />
                    <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="{x:Bind Basis}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource MetricLabelTextStyle}" Text="{x:Bind WeightText}" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" MinWidth="56" TextAlignment="Right" FontWeight="SemiBold" Text="{x:Bind ScoreText}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="BatteryCardTemplate" x:DataType="vm:BatteryCardDisplay">
            <StackPanel Spacing="20" Margin="0,0,0,20">

                <!-- Hero -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="24,22">
                    <StackPanel Spacing="16">
                        <controls:CardHeader Glyph="&#xE850;" Text="{x:Bind Title}" />
                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Bottom">
                            <TextBlock Style="{StaticResource HeroMetricTextStyle}" Text="{x:Bind Percentage.Text}" />
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource SecondaryMetricTextStyle}" Text="{x:Bind State.Text}" />
                                <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="{x:Bind AcOnline.Text}" />
                            </StackPanel>
                        </StackPanel>
                        <ProgressBar Maximum="100" Value="{x:Bind PercentageValue}" />
                        <StackPanel Orientation="Horizontal" Spacing="30">
                            <controls:MetricStat Label="Design capacity" Value="{x:Bind Design.Text}" />
                            <controls:MetricStat Label="Full charge" Value="{x:Bind Full.Text}" />
                            <controls:MetricStat Label="Remaining" Value="{x:Bind Remaining.Text}" />
                            <controls:MetricStat
                                Label="Retention"
                                Value="{x:Bind Retention.Text}"
                                BadgeText="{x:Bind Retention.BadgeText}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Electrical -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="14">
                        <controls:CardHeader Glyph="&#xE945;" Text="ELECTRICAL" />
                        <StackPanel Orientation="Horizontal" Spacing="30">
                            <controls:MetricStat Label="Voltage" Value="{x:Bind Voltage.Text}" BadgeText="{x:Bind Voltage.BadgeText}" />
                            <controls:MetricStat Label="Power" Value="{x:Bind Power.Text}" BadgeText="{x:Bind Power.BadgeText}" />
                            <controls:MetricStat Label="Current" Value="{x:Bind Current.Text}" BadgeText="{x:Bind Current.BadgeText}"
                                InfoText="Current is calculated as power ÷ voltage — it is never read directly from the hardware." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Identity and lifetime -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="14">
                        <controls:CardHeader Glyph="&#xE7C1;" Text="IDENTITY AND LIFETIME" />
                        <StackPanel Orientation="Horizontal" Spacing="30">
                            <controls:MetricStat Label="Cycle count" Value="{x:Bind CycleCount.Text}" BadgeText="{x:Bind CycleCount.BadgeText}" />
                            <controls:MetricStat Label="Temperature" Value="{x:Bind Temperature.Text}" BadgeText="{x:Bind Temperature.BadgeText}" />
                        </StackPanel>
                        <TextBlock
                            Foreground="{ThemeResource AppText3Brush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Identity}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="{StaticResource PageContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Battery" />
                <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="Identity, capacity, health score, degradation trend and remaining runtime." />
            </StackPanel>
            <Button
                Grid.Column="1"
                Margin="16,4,0,0"
                VerticalAlignment="Top"
                AutomationProperties.Name="Refresh battery readings now"
                Command="{x:Bind ViewModel.RefreshCommand}"
                Content="Refresh" />
        </Grid>

        <controls:EmptyStateView
            Grid.Row="1"
            VerticalAlignment="Top"
            Glyph="&#xE850;"
            Title="No battery detected"
            Description="No source (WinRT, WMI, IOCTL or GetSystemPowerStatus) found a battery device on this machine. This is expected on a desktop."
            Visibility="{x:Bind ViewModel.NoBattery, Mode=OneWay}" />

        <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" Grid.Row="1" Visibility="{x:Bind ViewModel.HasBattery, Mode=OneWay}">
            <StackPanel MaxWidth="1000" HorizontalAlignment="Left" Spacing="16">
                <InfoBar
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.LastError, Mode=OneWay}"
                    Severity="Warning"
                    Title="Last read failed; showing the previous reading." />

                <ContentControl
                    Visibility="{x:Bind ViewModel.HasMultipleBatteries, Mode=OneWay}"
                    Content="{x:Bind ViewModel.Aggregate, Mode=OneWay}"
                    ContentTemplate="{StaticResource BatteryCardTemplate}"
                    HorizontalContentAlignment="Stretch" />

                <ItemsControl ItemsSource="{x:Bind ViewModel.Batteries, Mode=OneWay}" ItemTemplate="{StaticResource BatteryCardTemplate}" />

                <!-- Battery Health Score -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="24,22">
                    <StackPanel Spacing="16">
                        <controls:CardHeader Glyph="&#xE95E;" Text="BATTERY HEALTH SCORE" />

                        <StackPanel Visibility="{x:Bind ViewModel.HealthUnavailable, Mode=OneWay}" Spacing="6">
                            <TextBlock Style="{StaticResource SecondaryMetricTextStyle}" Text="Unavailable" />
                            <TextBlock Foreground="{ThemeResource AppText2Brush}" TextWrapping="Wrap"
                                Text="The score requires capacity retention (full-charge ÷ design capacity). One of those readings is not available on this hardware, so no score is shown — a number built only on behavioural proxies would have nothing real underneath it." />
                        </StackPanel>

                        <StackPanel Visibility="{x:Bind ViewModel.HealthAvailable, Mode=OneWay}" Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Bottom">
                                <TextBlock Style="{StaticResource HeroMetricTextStyle}" Text="{x:Bind ViewModel.HealthScoreText, Mode=OneWay}" />
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource SecondaryMetricTextStyle}" Foreground="{ThemeResource AppText2Brush}" Text="{x:Bind ViewModel.HealthCategoryText, Mode=OneWay}" />
                                <Border Style="{StaticResource GradeBadgeAccentBorderStyle}">
                                    <TextBlock Style="{StaticResource GradeBadgeTextStyle}" Foreground="{ThemeResource AppAccentDeepBrush}" Text="ESTIMATED" />
                                </Border>
                            </StackPanel>
                            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="How this score is calculated">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource MetricLabelTextStyle}" TextWrapping="Wrap"
                                        Text="HealthScoreV1 — a weighted score over the available factors only. Weights are renormalised across whatever this hardware can report; a factor with no data has its weight redistributed to the others." />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.HealthFactors, Mode=OneWay}" ItemTemplate="{StaticResource HealthFactorTemplate}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Degradation trend -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <controls:CardHeader Glyph="&#xE9D2;" Text="DEGRADATION TREND" />
                        <controls:Sparkline
                            Height="60"
                            Visibility="{x:Bind ViewModel.HasRetentionSpark, Mode=OneWay}"
                            Values="{x:Bind ViewModel.RetentionSpark, Mode=OneWay}"
                            LineBrush="{ThemeResource AppAccentBrush}"
                            FillBrush="{ThemeResource AppAccentSoftBrush}" />
                        <TextBlock Foreground="{ThemeResource AppText2Brush}" TextWrapping="Wrap" Text="{x:Bind ViewModel.DegradationLine, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- Time remaining -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="14">
                        <controls:CardHeader Glyph="&#xE945;" Text="TIME REMAINING" />
                        <StackPanel Visibility="{x:Bind ViewModel.RuntimeCalculating, Mode=OneWay}" Spacing="4">
                            <TextBlock Style="{StaticResource SecondaryMetricTextStyle}" Text="Calculating…" />
                            <TextBlock Foreground="{ThemeResource AppText2Brush}" TextWrapping="Wrap"
                                Text="A wildly wrong estimate on launch costs more trust than a short wait. The figure appears once there is at least a minute of discharge history." />
                        </StackPanel>
                        <StackPanel Visibility="{x:Bind ViewModel.RuntimeAvailable, Mode=OneWay}" Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="30">
                                <controls:MetricStat Label="At current usage" Value="{x:Bind ViewModel.RuntimeAtCurrent, Mode=OneWay}"
                                    InfoText="An estimate: remaining capacity ÷ a recency-weighted discharge rate. It moves as your usage changes." />
                                <controls:MetricStat Label="Screen on" Value="{x:Bind ViewModel.RuntimeScreenOn, Mode=OneWay}" />
                                <controls:MetricStat Label="Screen off" Value="{x:Bind ViewModel.RuntimeScreenOff, Mode=OneWay}"
                                    InfoText="Shown only once real screen-off history exists — the display is usually the largest drain, so this is never extrapolated from the screen-on rate." />
                            </StackPanel>
                            <TextBlock Style="{StaticResource MetricLabelTextStyle}" TextWrapping="Wrap" Text="{x:Bind ViewModel.RuntimeConfidence, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>

</Page>
