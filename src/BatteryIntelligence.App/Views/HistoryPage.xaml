<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BatteryIntelligence.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BatteryIntelligence.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="{StaticResource PageContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="History" />
            <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="Interactive charts over 24 hours to a year, with zoom and export." />
        </StackPanel>

        <controls:EmptyStateView
            Grid.Row="1"
            VerticalAlignment="Top"
            Glyph="&#xE823;"
            Title="No history view yet"
            Description="The tier-aware history charts and the CSV / JSON export arrive in Phase 11. Samples are already being recorded to the local database, so the range will be populated when the page ships." />
    </Grid>

</Page>
