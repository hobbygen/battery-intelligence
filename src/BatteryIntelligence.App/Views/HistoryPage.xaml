<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BatteryIntelligence.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BatteryIntelligence.App.Controls"
    xmlns:vm="using:BatteryIntelligence.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="{StaticResource PageContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="History" />
            <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="Interactive charts over 24 hours to a year, with zoom and export." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto">
            <StackPanel MaxWidth="1000" HorizontalAlignment="Left" Spacing="20">

                <!-- Chart -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="16">
                        <controls:CardHeader Glyph="&#xE9D2;" Text="TREND" />

                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:Segmented
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Metric"
                                ItemsSource="{x:Bind ViewModel.MetricOptions}"
                                SelectedIndex="{x:Bind ViewModel.SelectedMetricIndex, Mode=TwoWay}" />
                            <controls:Segmented
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                AutomationProperties.Name="Time range"
                                ItemsSource="{x:Bind ViewModel.RangeOptions}"
                                SelectedIndex="{x:Bind ViewModel.SelectedRangeIndex, Mode=TwoWay}" />
                        </Grid>

                        <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

                        <controls:PowerChart
                            EnableZoom="True"
                            RangeEndUtc="{x:Bind ViewModel.RangeEndUtc, Mode=OneWay}"
                            RangeStartUtc="{x:Bind ViewModel.RangeStartUtc, Mode=OneWay}"
                            Series="{x:Bind ViewModel.Series, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.ShowChart, Mode=OneWay}" />

                        <TextBlock
                            Foreground="{ThemeResource AppText3Brush}"
                            Style="{StaticResource MetricLabelTextStyle}"
                            Text="{x:Bind ViewModel.TierCaption, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.ShowChart, Mode=OneWay}" />

                        <controls:EmptyStateView
                            Glyph="&#xE9D2;"
                            Title="Nothing to chart yet"
                            Description="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}" />

                        <controls:EmptyStateView
                            Glyph="&#xE9CA;"
                            Title="No temperature sensor"
                            Description="This battery does not report temperature, so there is no history to chart. Every other metric works normally."
                            Visibility="{x:Bind ViewModel.ShowTemperatureUnavailable, Mode=OneWay}" />

                        <TextBlock
                            Foreground="{ThemeResource AppText3Brush}"
                            Style="{StaticResource MetricLabelTextStyle}"
                            Text="Scroll or pinch the chart to zoom the time axis; double-tap to reset." />
                    </StackPanel>
                </Border>

                <!-- Export -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="14">
                        <controls:CardHeader Glyph="&#xEDE1;" Text="EXPORT" />
                        <TextBlock
                            Foreground="{ThemeResource AppText2Brush}"
                            TextWrapping="Wrap"
                            Text="Choose the tables to include, then a format. Exports cover the whole recorded history. The file is written only where you choose to save it." />

                        <TextBlock Text="{x:Bind ViewModel.ExtentCaption, Mode=OneWay}" Style="{StaticResource MetricLabelTextStyle}" Foreground="{ThemeResource AppText3Brush}" />

                        <ItemsControl ItemsSource="{x:Bind ViewModel.ExportScopes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ExportScopeOption">
                                    <CheckBox Content="{x:Bind Label}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Command="{x:Bind ViewModel.ExportCsvCommand}" Content="Export CSV" Style="{StaticResource AccentButtonStyle}" />
                            <Button Command="{x:Bind ViewModel.ExportJsonCommand}" Content="Export JSON" />
                        </StackPanel>

                        <InfoBar
                            IsClosable="True"
                            IsOpen="{x:Bind ViewModel.HasExportResult, Mode=OneWay}"
                            Message="{x:Bind ViewModel.ExportResultMessage, Mode=OneWay}"
                            Severity="Informational" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>

</Page>
