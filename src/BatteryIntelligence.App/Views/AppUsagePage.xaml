<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BatteryIntelligence.App.Views.AppUsagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BatteryIntelligence.App.Controls"
    xmlns:vm="using:BatteryIntelligence.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="AppUsageRowTemplate" x:DataType="vm:AppUsageRow">
            <Grid Padding="4,12" ColumnSpacing="14" BorderBrush="{ThemeResource AppLine2Brush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Width="34" Height="34"
                    VerticalAlignment="Top"
                    CornerRadius="8"
                    Background="{ThemeResource AppAccentSoftBrush}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AppAccentDeepBrush}"
                        Text="{x:Bind Monogram}" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Bind Name}" />
                        <Border
                            CornerRadius="3"
                            Padding="5,0,5,1"
                            VerticalAlignment="Center"
                            Background="{ThemeResource AppOkSoftBrush}"
                            Visibility="{x:Bind IsForeground}">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AppOkBrush}" Text="IN FRONT" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="{x:Bind CpuText}" />
                        <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="{x:Bind MemoryText}" />
                    </StackPanel>
                    <ProgressBar Minimum="0" Maximum="100" Height="6" Value="{x:Bind BarPercent}" />
                </StackPanel>

                <StackPanel Grid.Column="2" MinWidth="96" HorizontalAlignment="Right" Spacing="2">
                    <TextBlock HorizontalAlignment="Right" FontSize="15" FontWeight="SemiBold" Text="{x:Bind PowerText}" />
                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource MetricLabelTextStyle}" Text="{x:Bind ShareText}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="{StaticResource PageContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="App Usage" />
                    <Border Style="{StaticResource GradeBadgeAccentBorderStyle}" VerticalAlignment="Center" Margin="0,2,0,6">
                        <TextBlock Style="{StaticResource GradeBadgeTextStyle}" Foreground="{ThemeResource AppAccentDeepBrush}" Text="ESTIMATED" />
                    </Border>
                </StackPanel>
                <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Margin="16,4,0,0"
                VerticalAlignment="Top"
                AutomationProperties.Name="Re-sample application usage now"
                Command="{x:Bind ViewModel.RefreshCommand}"
                Content="Refresh" />
        </Grid>

        <controls:EmptyStateView
            Grid.Row="1"
            VerticalAlignment="Top"
            Glyph="&#xE71D;"
            Title="Ranking the first sample"
            Description="The process sampler runs on a ten-second cadence to keep its own cost low. The first ranked list appears within a few seconds; every figure will carry an Estimated badge, because Windows does not expose measured per-process energy without administrator rights."
            Visibility="{x:Bind ViewModel.ShowLoading, Mode=OneWay}" />

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Auto"
            Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}">
            <StackPanel MaxWidth="1000" HorizontalAlignment="Left" Spacing="20">

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.OnAcPower, Mode=OneWay}"
                    Severity="Informational"
                    Title="Ranked, not measured in watts"
                    Message="You are on AC power. There is no battery draw to divide, so applications are ranked by relative CPU activity and absolute milliwatt figures are shown as “—”. Unplug to see estimated power." />

                <!-- Hero -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="24,22">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:CardHeader
                                Grid.Column="0"
                                Glyph="&#xE71D;"
                                Text="APPLICATION USAGE"
                                ActionText="How this is estimated"
                                ActionInvoked="OnMethodologyAction" />
                            <controls:Segmented
                                Grid.Column="1"
                                AutomationProperties.Name="Time window"
                                ItemsSource="{x:Bind ViewModel.WindowOptions}"
                                SelectedIndex="{x:Bind ViewModel.SelectedWindowIndex, Mode=TwoWay}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
                            <TextBlock Style="{StaticResource HeroMetricTextStyle}" Text="{x:Bind ViewModel.TotalText, Mode=OneWay}" />
                            <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource AppText3Brush}" Text="measured system draw" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource MetricLabelTextStyle}" TextWrapping="Wrap" Text="{x:Bind ViewModel.ConfidenceText, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- Ranking -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:CardHeader Grid.Column="0" Glyph="&#xE9D9;" Text="BY APPLICATION" />
                            <controls:Segmented
                                Grid.Column="1"
                                AutomationProperties.Name="Sort order"
                                ItemsSource="{x:Bind ViewModel.SortOptions}"
                                SelectedIndex="{x:Bind ViewModel.SelectedSortIndex, Mode=TwoWay}" />
                        </Grid>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" ItemTemplate="{StaticResource AppUsageRowTemplate}" />
                    </StackPanel>
                </Border>

                <!-- Baseline -->
                <Border Style="{StaticResource CardBorderStyle}" Visibility="{x:Bind ViewModel.HasBaseline, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <controls:CardHeader Glyph="&#xE9CE;" Text="SYSTEM BASELINE" />
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="Display, radios and chipset idle" />
                                <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="{x:Bind ViewModel.BaselineRow.ShareText, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{x:Bind ViewModel.BaselineRow.PowerText, Mode=OneWay}" />
                        </Grid>
                        <TextBlock
                            Style="{StaticResource MetricLabelTextStyle}"
                            TextWrapping="Wrap"
                            Text="Some draw belongs to no application — the backlight, Wi-Fi and Bluetooth radios, and chipset idle. It is separated first and shown here so the per-app shares add up without double-counting it." />
                    </StackPanel>
                </Border>

                <!-- Methodology -->
                <Border Style="{StaticResource InsetPanelBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Foreground="{ThemeResource AppText2Brush}"
                            TextWrapping="Wrap"
                            Text="AppEnergyV1 ranks applications by likely battery impact and apportions the measured total among them by a CPU-and-foreground activity weight. It does not measure any single application's consumption — two apps with equal CPU time can differ substantially in real energy use." />
                        <HyperlinkButton Padding="0" Content="Read the full methodology on the About page" Click="OnMethodologyClick" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>

</Page>
