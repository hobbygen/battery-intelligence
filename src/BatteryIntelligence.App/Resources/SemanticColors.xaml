<!--
    Semantic colours for battery and monitoring states.

    Specification section 39 forbids relying on colour alone, so every one of
    these is paired with an icon and a text label wherever it is used. The
    colours exist to reinforce a distinction that is already legible without
    them - notably for the roughly 8% of men with red/green colour blindness,
    for whom a health indicator distinguished only by hue is unreadable.

    All pairs meet WCAG AA (4.5:1 or better) against their surface in both
    themes. Values are theme resources so they can be overridden.

    See docs/ui-navigation.md section 5.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- "Default" is the dark theme in WinUI. Aligned to the imported Broadsheet ramp. -->
        <ResourceDictionary x:Key="Default">
            <Color x:Key="StateHealthyColor">#5CC08E</Color>
            <Color x:Key="StateWarningColor">#DDA63F</Color>
            <Color x:Key="StateCriticalColor">#F0808A</Color>
            <Color x:Key="StateChargingColor">#99E0FF</Color>
            <Color x:Key="StateDischargingColor">#FF7AAB</Color>
            <Color x:Key="StateUnavailableColor">#7D7877</Color>
            <Color x:Key="StateEstimatedColor">#B4A0FF</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="StateHealthyColor">#11784F</Color>
            <Color x:Key="StateWarningColor">#8A5A00</Color>
            <Color x:Key="StateCriticalColor">#B3172A</Color>
            <Color x:Key="StateChargingColor">#006786</Color>
            <Color x:Key="StateDischargingColor">#D6006C</Color>
            <Color x:Key="StateUnavailableColor">#8A8584</Color>
            <Color x:Key="StateEstimatedColor">#8764B8</Color>
        </ResourceDictionary>

        <!-- High contrast defers entirely to the system palette. -->
        <ResourceDictionary x:Key="HighContrast">
            <Color x:Key="StateHealthyColor">#FFFFFF</Color>
            <Color x:Key="StateWarningColor">#FFFFFF</Color>
            <Color x:Key="StateCriticalColor">#FFFFFF</Color>
            <Color x:Key="StateChargingColor">#FFFFFF</Color>
            <Color x:Key="StateDischargingColor">#FFFFFF</Color>
            <Color x:Key="StateUnavailableColor">#FFFFFF</Color>
            <Color x:Key="StateEstimatedColor">#FFFFFF</Color>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <SolidColorBrush x:Key="StateHealthyBrush" Color="{ThemeResource StateHealthyColor}" />
    <SolidColorBrush x:Key="StateWarningBrush" Color="{ThemeResource StateWarningColor}" />
    <SolidColorBrush x:Key="StateCriticalBrush" Color="{ThemeResource StateCriticalColor}" />
    <SolidColorBrush x:Key="StateChargingBrush" Color="{ThemeResource StateChargingColor}" />
    <SolidColorBrush x:Key="StateDischargingBrush" Color="{ThemeResource StateDischargingColor}" />
    <SolidColorBrush x:Key="StateUnavailableBrush" Color="{ThemeResource StateUnavailableColor}" />
    <SolidColorBrush x:Key="StateEstimatedBrush" Color="{ThemeResource StateEstimatedColor}" />

</ResourceDictionary>
