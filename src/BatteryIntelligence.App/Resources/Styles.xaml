<!--
    Shared styles. Visual language imported from Claude Design
    ("Battery Intelligence.dc.html"); card anatomy follows docs/ui-navigation.md
    section 4. Colour tokens live in AppTheme.xaml.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Page gutters and grid rhythm (design: padding 26 / 30 / 40, section gap 20). -->
    <Thickness x:Key="PageContentMargin">30,24,30,40</Thickness>
    <Thickness x:Key="CardPadding">20</Thickness>
    <x:Double x:Key="CardMinWidth">300</x:Double>
    <x:Double x:Key="SectionGap">20</x:Double>
    <x:Double x:Key="CardGridSpacing">20</x:Double>

    <!-- Page title, shown once at the top of each page. -->
    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
    </Style>

    <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource AppText3Brush}" />
        <Setter Property="Margin" Value="0,0,0,20" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Legacy section header, kept for pages not yet reworked. -->
    <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="0,20,0,8" />
    </Style>

    <!-- Card kicker: 11px caps label, always paired with a 16px glyph. Author labels in UPPER CASE. -->
    <Style x:Key="CardKickerTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="90" />
        <Setter Property="Foreground" Value="{ThemeResource AppText3Brush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Metric type scale (spec sheet §2). Sans, not the serif of the source. -->
    <Style x:Key="HeroMetricTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="66" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="62" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
    </Style>

    <Style x:Key="PrimaryMetricTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
    </Style>

    <Style x:Key="SecondaryMetricTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
    </Style>

    <Style x:Key="MetricLabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource AppText3Brush}" />
    </Style>

    <Style x:Key="MetricUnitTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{ThemeResource AppText3Brush}" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <!-- Standard dashboard/content card. -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <!-- A subordinate panel inside a card (e.g. the log box, a nested table). -->
    <Style x:Key="InsetPanelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppLine2Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <!--
        Badge shown beside any value that is not directly measured.
        Measured values deliberately carry no badge: if everything is badged,
        nothing is, and the "Estimated" badge is the one that must register.
    -->
    <Style x:Key="GradeBadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="CharacterSpacing" Value="50" />
        <Setter Property="Foreground" Value="{ThemeResource AppText3Brush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Calculated: a quiet outline. -->
    <Style x:Key="GradeBadgeBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource AppLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,1,6,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Estimated: a filled accent tint, always visible. -->
    <Style x:Key="GradeBadgeAccentBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppAccentSoftBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,1,6,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Small status chip (ok / warn / crit / charging) used on cards and in the title bar. -->
    <Style x:Key="StatusChipBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="8,2,8,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Trailing "Details →" style link on a card header. -->
    <Style x:Key="CardActionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource AppAccentDeepBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
