<?xml version="1.0" encoding="utf-8"?>

<!--
  MSIX manifest for the packaged release build. Only used when the project is
  built with -p:EnablePackaging=true (docs/release.md); the default build is
  unpackaged (WindowsPackageType=None) and ignores this file.

  Two places carry the version: <Identity Version> here (four-part) and
  <Version> in Directory.Build.props. Bump both together.

  The Publisher CN must match the code-signing certificate's subject
  (docs/release.md §Signing). "CN=Battery Intelligence" is the development
  placeholder.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap uap3 rescap desktop">

  <Identity
    Name="BatteryIntelligence"
    Publisher="CN=Battery Intelligence"
    Version="1.0.0.0" />

  <Properties>
    <DisplayName>Battery Intelligence</DisplayName>
    <PublisherDisplayName>Battery Intelligence</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Understand your laptop battery, power draw and battery health — locally, with no account and no fabricated numbers.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="BatteryIntelligence.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Battery Intelligence"
        Description="Understand your laptop battery, power draw and battery health — locally, with no account and no fabricated numbers."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- "Start with Windows" for the packaged app; the setting toggles it on/off. -->
        <uap3:Extension Category="windows.startupTask">
          <uap3:StartupTask TaskId="BatteryIntelligenceStartup" Enabled="false" DisplayName="Battery Intelligence" />
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Desktop full-trust: the app reads ACPI / power-management interfaces and
         enumerates processes, exactly as it does unpackaged. No broad or
         sensitive capability is requested. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
