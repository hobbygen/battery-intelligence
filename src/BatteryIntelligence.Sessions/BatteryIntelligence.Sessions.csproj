<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Windows-targeted, unlike Core: the orchestrator in this project subscribes
    directly to BatteryMessageWindow for suspend/resume/screen/lock (S5-S7).
    The pure state machine it drives (Core.Sessions.SessionStateMachine) stays
    in Core precisely so it remains testable from the plain-net10.0 Tests.Unit
    project without this project's Windows dependency — see docs/roadmap.md
    Phase 4 for why the split landed here instead of keeping this whole project
    hardware-free as originally stubbed in Phase 1.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>BatteryIntelligence.Sessions</RootNamespace>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BatteryIntelligence.Core\BatteryIntelligence.Core.csproj" />
    <ProjectReference Include="..\BatteryIntelligence.Windows\BatteryIntelligence.Windows.csproj" />
  </ItemGroup>

</Project>
