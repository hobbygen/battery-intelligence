<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!--
      Unlike the App and Battery projects, SIMULATION is defined unconditionally
      here, in every configuration: this project's entire purpose is exercising
      the simulated providers (docs/testing.md section 4), so it must never build
      without them.
    -->
    <DefineConstants>$(DefineConstants);SIMULATION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BatteryIntelligence.Core\BatteryIntelligence.Core.csproj" />
    <!--
      Always pinned to Debug regardless of this project's own configuration:
      SimulatedBatteryProvider only exists in a Debug build of Battery (the
      SIMULATION symbol is Debug-only there, unconditional here). Without this
      pin, building the solution in Release would hand this project a Battery.dll
      missing the very types it tests.
    -->
    <ProjectReference
        Include="..\..\src\BatteryIntelligence.Battery\BatteryIntelligence.Battery.csproj"
        AdditionalProperties="Configuration=Debug" />
    <ProjectReference Include="..\..\src\BatteryIntelligence.Power\BatteryIntelligence.Power.csproj" />
    <ProjectReference Include="..\..\src\BatteryIntelligence.Thermal\BatteryIntelligence.Thermal.csproj" />
    <ProjectReference Include="..\..\src\BatteryIntelligence.ProcessMonitoring\BatteryIntelligence.ProcessMonitoring.csproj" />
    <ProjectReference Include="..\..\src\BatteryIntelligence.Analytics\BatteryIntelligence.Analytics.csproj" />
  </ItemGroup>

</Project>
