<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 (missing XML comment) is suppressed because XAML-generated partial
         classes are public and cannot be documented. Public APIs in library
         projects are documented by convention; see docs/architecture.md. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    Version single source of truth. To ship a new version bump BOTH this block
    and the <Identity Version="…"> in src/BatteryIntelligence.App/Package.appxmanifest
    (four-part, e.g. 1.1.0.0). See docs/release.md.
  -->
  <PropertyGroup>
    <Product>Battery Intelligence</Product>
    <Company>Battery Intelligence</Company>
    <Authors>Battery Intelligence</Authors>
    <Copyright>Copyright © 2026 Battery Intelligence. MIT licensed.</Copyright>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

</Project>
